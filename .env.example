# ============================================================
#  GALLERO PRO - Variables de entorno
#  Copia este archivo a .env y ajusta los valores
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=galleropro
DB_PASSWORD=galleropro_secret
DB_NAME=galleropro

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=cambia_este_secret_en_produccion_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro_secret_diferente_para_refresh_token
JWT_REFRESH_EXPIRES_IN=30d

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx

# --- SendGrid (email) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@galleropro.com

# --- Twilio (WhatsApp + SMS) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

# --- Cloudflare R2 (almacenamiento) ---
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=galleropro-media
R2_PUBLIC_URL=https://media.galleropro.com

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=GALLERO PRO
